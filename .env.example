# Add your ROTATED Neon connection string in Vercel project settings.
# Never commit .env.local or paste a password into docs.
DATABASE_URL=

# Development branch Neon Managed Auth. Keep the cookie secret private and
# generate a separate value for each deployment environment.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Comma-separated Neon Auth user IDs explicitly approved for editor access.
# Leave empty until the owner has provisioned and verified an admin identity.
EDITOR_ADMIN_USER_IDS=
